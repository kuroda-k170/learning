public function new_api()
{
    try {
        $result = $this->old_api_process();

        // 正常時
        $this->next_process();

    } catch (Exception $e) {
        log_message('error', 'old_api_process failed: ' . $e->getMessage());

        // エラーでも処理継続したい場合
        $this->next_process();

        // 必要ならレスポンスは正常扱いにする
        echo json_encode([
            'success' => true,
            'message' => '一部処理でエラーがありましたが継続しました'
        ]);
    }
}